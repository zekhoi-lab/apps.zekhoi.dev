---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getApps, getAppSlug } from "../lib/apps";

const apps = await getApps();
---

<BaseLayout title="Apps and games by zekhoi">
  <h1>Apps and games</h1>
  <ul>
    {apps.map((app) => (
      <li>
        <a href={`/${getAppSlug(app)}`}>{app.data.name}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
