---
import { Content, frontmatter, getHeadings } from "../content/site/privacy.md";
import LegalLayout from "../layouts/LegalLayout.astro";
import { getApps, getAppSlug } from "../lib/apps";

const apps = await getApps();
const related = apps.map((app) => ({
  href: `/${getAppSlug(app)}/privacy`,
  label: `${app.data.name} privacy policy`,
}));
---

<LegalLayout
  title={frontmatter.title}
  description={frontmatter.description}
  updatedAt={new Date(frontmatter.updatedAt)}
  headings={getHeadings()}
  related={related}
>
  <Content />
</LegalLayout>
