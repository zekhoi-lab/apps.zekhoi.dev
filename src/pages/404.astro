---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/site";
---

<BaseLayout
  title={pageTitle("Page not found")}
  description="This page does not exist."
  noindex
>
  <div class="container-page max-w-2xl py-24 sm:py-32">
    <p class="text-accent text-sm font-semibold">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      Page not found
    </h1>
    <p class="text-muted mt-4 text-lg leading-relaxed">
      The page you are looking for does not exist or has moved.
    </p>
    <a
      href="/"
      class="bg-accent text-accent-fg hover:bg-accent-strong mt-8 inline-flex items-center rounded-full px-5 py-2.5 font-medium transition-colors"
    >
      See all apps
    </a>
  </div>
</BaseLayout>
