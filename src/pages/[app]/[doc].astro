---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import LegalLayout from "../../layouts/LegalLayout.astro";
import {
  DOC_LABELS,
  getApps,
  getAppSlug,
  getDocName,
  getDocs,
  type AppEntry,
  type DocEntry,
} from "../../lib/apps";
import { SITE } from "../../lib/site";

export const getStaticPaths = (async () => {
  const apps = await getApps();
  const paths = await Promise.all(
    apps.map(async (app) => {
      const slug = getAppSlug(app);
      const docs = await getDocs(slug);
      return docs.map((doc) => ({
        params: { app: slug, doc: getDocName(doc) },
        props: { app, doc, siblings: docs.filter((d) => d.id !== doc.id) },
      }));
    }),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

interface Props {
  app: AppEntry;
  doc: DocEntry;
  siblings: DocEntry[];
}

const { app, doc, siblings } = Astro.props;
const { Content, headings } = await render(doc);
const slug = getAppSlug(app);
const name = getDocName(doc);

const descriptions = {
  privacy: `How ${app.data.name} collects, uses, and protects your data.`,
  terms: `The terms for using ${app.data.name}.`,
  "delete-account": `How to delete your ${app.data.name} account and what happens to your data.`,
};

const related = [
  ...siblings.map((sibling) => ({
    href: `/${slug}/${getDocName(sibling)}`,
    label: DOC_LABELS[getDocName(sibling)],
  })),
  { href: `/${slug}/support`, label: "Support" },
];
---

<LegalLayout
  title={doc.data.title}
  description={doc.data.description ?? descriptions[name]}
  updatedAt={doc.data.updatedAt}
  headings={headings}
  app={app}
  byline={`${app.data.name} by ${SITE.developer}`}
  related={related}
>
  <Content />
</LegalLayout>
