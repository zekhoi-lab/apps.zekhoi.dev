---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { getAppSlug, type AppEntry } from "../lib/apps";
import { formatDate } from "../lib/site";

interface Props {
  title: string;
  description: string;
  updatedAt: Date;
  headings: MarkdownHeading[];
  app?: AppEntry;
  /** Short line under the title, such as "Daylime by zekhoi". */
  byline?: string;
  /** Related pages listed at the end of the document. */
  related?: { href: string; label: string }[];
}

const {
  title,
  description,
  updatedAt,
  headings,
  app,
  byline,
  related = [],
} = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const pageTitle = app ? `${title} - ${app.data.name}` : title;
---

<BaseLayout
  title={pageTitle}
  description={description}
  image={app?.data.ogImage}
  app={app}
>
  <div class="container-page lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
    <aside class="hidden lg:block">
      {sections.length > 1 && (
        <nav aria-label="On this page" class="sticky top-8 mt-16 text-sm">
          <h2 class="text-muted font-medium">On this page</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5">
            {sections.map((heading) => (
              <li class="text-muted marker:text-muted">
                <a
                  href={`#${heading.slug}`}
                  class="hover:text-fg rounded-sm leading-snug transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </aside>

    <article class="max-w-[68ch] py-16">
      <header>
        {app && (
          <a
            href={`/${getAppSlug(app)}`}
            class="text-muted hover:text-fg inline-flex items-center gap-2 rounded-sm text-sm font-medium transition-colors"
          >
            <svg
              class="size-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M10 3 5 8l5 5" />
            </svg>
            {app.data.name}
          </a>
        )}
        <h1 class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
          {title}
        </h1>
        {byline && <p class="mt-3 text-lg">{byline}</p>}
        <p class="text-muted mt-2 text-sm">
          Last updated{" "}
          <time datetime={updatedAt.toISOString().slice(0, 10)}>
            {formatDate(updatedAt)}
          </time>
        </p>
      </header>

      {sections.length > 1 && (
        <nav
          aria-label="Contents"
          class="border-border mt-10 rounded-card border p-5 lg:hidden"
        >
          <h2 class="font-semibold">Contents</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5">
            {sections.map((heading) => (
              <li class="marker:text-muted">
                <a href={`#${heading.slug}`} class="link">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose-doc mt-10">
        <slot />
      </div>

      {related.length > 0 && (
        <nav
          aria-label="Related pages"
          class="border-border mt-16 border-t pt-8"
        >
          <h2 class="font-semibold">Related</h2>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {related.map((link) => (
              <li>
                <a href={link.href} class="link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
