---
import { Image } from "astro:assets";
import AppMeta from "./AppMeta.astro";
import { getAppSlug, type AppEntry } from "../lib/apps";

interface Props {
  app: AppEntry;
  headingLevel?: "h2" | "h3";
}

const { app, headingLevel: Heading = "h2" } = Astro.props;
const { name, tagline, icon, type } = app.data;
---

<article
  class="group rounded-card border-border bg-surface hover:border-border-strong hover:shadow-card relative flex h-full gap-5 border p-5 transition sm:p-6 dark:hover:shadow-none"
  data-type={type}
>
  <Image
    src={icon}
    alt=""
    width={64}
    height={64}
    densities={[1, 2]}
    class="rounded-icon size-16 shrink-0"
  />
  <div class="min-w-0">
    <Heading class="text-lg leading-snug font-semibold">
      <a
        href={`/${getAppSlug(app)}`}
        class="rounded-sm after:absolute after:inset-0 after:rounded-card"
      >
        {name}
      </a>
    </Heading>
    <p class="text-muted mt-1 leading-relaxed">{tagline}</p>
    <div class="mt-3">
      <AppMeta app={app} showType />
    </div>
  </div>
</article>
