---
import { SITE } from "../lib/site";

interface Props {
  current?: "home";
}

const { current } = Astro.props;
---

<header class="border-border border-b">
  <div class="container-page flex h-16 items-center justify-between">
    <a
      href="/"
      class="flex items-baseline gap-1.5 rounded-sm font-semibold tracking-tight"
      aria-current={current === "home" ? "page" : undefined}
    >
      {SITE.developer}
      <span class="text-muted font-normal">apps</span>
    </a>
    <nav aria-label="Main">
      <a
        href="/"
        class="text-muted hover:text-fg rounded-sm text-sm transition-colors"
      >
        All apps
      </a>
    </nav>
  </div>
</header>
